{
  "opencollection": "1.0.0",
  "info": {
    "name": "Huntress API Reference Accounts Identities API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Identities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Identities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/identities",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Max number of resources returned in a paged collection. Defaults to 10, with a minimum of 1 and maximum 500."
              },
              {
                "name": "page_token",
                "value": "",
                "type": "query",
                "description": "Token used to request the next page in paginated results. Defaults to 'null'"
              },
              {
                "name": "sort_field",
                "value": "",
                "type": "query",
                "description": "Field to sort by. Defaults to 'id'."
              },
              {
                "name": "sort_direction",
                "value": "",
                "type": "query",
                "description": "Sort direction. Defaults to 'desc'."
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query",
                "description": "Filter by organization ID within Huntress account."
              },
              {
                "name": "tenant_type",
                "value": "",
                "type": "query",
                "description": "Filter by identity provider type."
              },
              {
                "name": "billable",
                "value": "",
                "type": "query",
                "description": "Filter by billable status."
              },
              {
                "name": "enabled",
                "value": "",
                "type": "query",
                "description": "Filter by enabled status."
              },
              {
                "name": "external",
                "value": "",
                "type": "query",
                "description": "Filter by external/guest status."
              },
              {
                "name": "risk_level",
                "value": "",
                "type": "query",
                "description": "Filter by risk level."
              },
              {
                "name": "mfa_enabled",
                "value": "",
                "type": "query",
                "description": "Filter by MFA enabled status."
              },
              {
                "name": "escalation_id",
                "value": "",
                "type": "query",
                "description": "Filter by an escalation ID within Huntress account."
              }
            ]
          },
          "docs": "Shows Identities associated with your account.\n\n**Note:** This endpoint will also return a `pagination` key on the root level.\nPlease refer to the [pagination section](https://api.huntress.io/docs#pagination) within our docs for more information.\n"
        },
        {
          "info": {
            "name": "Get Identity",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/identities/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identity ID."
              }
            ]
          },
          "docs": "Shows details on a single Identity associated with your account."
        }
      ]
    }
  ],
  "bundled": true
}